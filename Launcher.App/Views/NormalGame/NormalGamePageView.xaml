<UserControl x:Class="Launcher.App.Views.NormalGame.NormalGamePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Launcher.App.Views.Home"
             Focusable="False">
    <Grid x:Name="PageRoot">
        <Border Margin="24,24,48,32"
                CornerRadius="20"
                Background="{DynamicResource Brush.Home.Surface}"
                BorderBrush="{DynamicResource Brush.Home.CardBorder}"
                BorderThickness="1">
            <Grid>
                <views:HomeLaunchPanelView />
                <views:HomeLaunchGameListView DataContext="{Binding LaunchGames}"
                                              Panel.ZIndex="4" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
