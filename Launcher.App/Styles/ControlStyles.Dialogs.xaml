<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
                    xmlns:converters="clr-namespace:Launcher.App.Converters"
                    xmlns:res="clr-namespace:Launcher.App.Resources">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/BlockHelm_Launcher_x64;component/Styles/ControlStyles.Scroll.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DialogOverlayStyle" TargetType="Grid">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Grid.RowSpan" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Material.Scrim.Fill}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style x:Key="DialogShadowStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.TransparentHit}" />
        <Setter Property="CornerRadius" Value="{StaticResource LauncherDialogCornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="{StaticResource Elevation.High.BlurRadius}"
                                  Color="{DynamicResource Color.000000}"
                                  Direction="270"
                                  Opacity="0.38"
                                  ShadowDepth="{StaticResource Elevation.High.ShadowDepth}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSurfaceStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Material.Floating.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Material.Floating.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LauncherDialogCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="behaviors:RoundedClip.Radius" Value="18" />
    </Style>

    <Style x:Key="DialogContentGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Thickness.Space.24}" />
    </Style>

    <Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title2.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.Title2.LineHeight}" />
    </Style>

    <Style x:Key="DialogSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
    </Style>

    <Style x:Key="DialogBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.BodyStrong.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.BodyStrong.LineHeight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogFieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DialogValidationTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Footnote.Size}" />
    </Style>

    <Style x:Key="DialogChoiceItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Border x:Name="BaseBackground"
                                    Background="{DynamicResource Brush.List.Item.Background}"
                                    behaviors:BackdropBlurHost.IsApplied="True"
                                    behaviors:BackdropBlurHost.IsBlurEnabled="{DynamicResource Is.Surface.BackdropBlur.Enabled}"
                                    behaviors:BackdropBlurHost.FallbackBrush="{DynamicResource Brush.List.Item.Background}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="SelectedBackground"
                                    Background="{DynamicResource Brush.List.Item.Selected}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="SelectedOutline"
                                    BorderBrush="{DynamicResource Brush.List.Item.SelectedBorder}"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.List.Item.Hover}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <ContentPresenter Margin="14"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectedOutline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SelectedOutline" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogChoiceListStyle" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DialogChoiceItemStyle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,22,0,18" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
        <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MainContentScrollBarStyle}" />
        </Style.Resources>
    </Style>

    <Style x:Key="DialogActionItemButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Background}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Border x:Name="BaseBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.List.Item.Hover}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.Button.Secondary.Pressed}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="BaseBackground" Property="Background" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogFormPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,24,0,24" />
    </Style>

    <Style x:Key="DialogDropZoneBorderStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="148" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.24FFFFFF}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="behaviors:RoundedClip.Radius" Value="16" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LocalImportDialog.IsDragOver}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.List.Item.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.List.Item.SelectedBorder}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DialogFooterStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="DialogTrailingButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="{StaticResource DialogTrailingButtonMargin}" />
    </Style>

    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Card.Surface}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.BodyStrong.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Border x:Name="BaseBackground"
                                    Background="{TemplateBinding Background}"
                                    behaviors:BackdropBlurHost.IsApplied="True"
                                    behaviors:BackdropBlurHost.IsBlurEnabled="{DynamicResource Is.Surface.BackdropBlur.Enabled}"
                                    behaviors:BackdropBlurHost.FallbackBrush="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="SurfaceContrastLayer"
                                    Background="{DynamicResource Brush.Button.Secondary.Background}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.Button.Secondary.Hover}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.Button.Secondary.Pressed}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=(behaviors:BackdropBlurHost.IsBlurEnabled), ElementName=BaseBackground}"
                                     Value="True">
                            <Setter TargetName="SurfaceContrastLayer" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="BaseBackground" Property="Background" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="BaseBackground" Property="behaviors:BackdropBlurHost.FallbackBrush" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="SurfaceContrastLayer" Property="Background" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="behaviors:SurfaceShadow.SuppressChildShadows" Value="True">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

