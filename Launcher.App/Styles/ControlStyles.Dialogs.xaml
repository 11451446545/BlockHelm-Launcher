                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="BaseBackground" Property="Background" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="BaseBackground" Property="behaviors:BackdropBlurHost.IsBlurEnabled" Value="{DynamicResource Is.Surface.BackdropBlur.Enabled}" />
                            <Setter TargetName="BaseBackground" Property="behaviors:BackdropBlurHost.FallbackBrush" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="SurfaceContrastLayer" Property="Background" Value="{DynamicResource Brush.Button.Secondary.Disabled}" />
                            <Setter TargetName="SemanticBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
