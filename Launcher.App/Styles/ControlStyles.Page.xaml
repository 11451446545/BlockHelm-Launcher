<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:Launcher.App.Controls"
                    xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
                    xmlns:converters="clr-namespace:Launcher.App.Converters"
                    xmlns:res="clr-namespace:Launcher.App.Resources">
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title1.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.Title1.LineHeight}" />
    </Style>

    <Style x:Key="PageStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.B8FFFFFF}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.Body.LineHeight}" />
    </Style>

    <Style x:Key="PageEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.B8FFFFFF}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title3.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Typography.Title3.LineHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="DownloadOverlayEmptyStateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PageEmptyStateTextStyle}">
        <Setter Property="Margin" Value="0,122,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="DownloadOverlayErrorTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DownloadOverlayEmptyStateTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFF8D8D}" />
    </Style>

    <Style x:Key="DownloadInstanceOptionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AFFFFFFF}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DownloadInstanceOptionWarningTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFC56D}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasInstanceNameDuplicateMessage}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadLoaderOptionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4F4F4}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DownloadLoaderOptionSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AFFFFFFF}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HomeAvatarContainerStyle" TargetType="Border">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSelectedAccount}" Value="True">
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeDefaultAvatarGlyphStyle" TargetType="TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="{StaticResource Elevation.Medium.BlurRadius}"
                                  Color="{DynamicResource Color.000000}"
                                  Direction="270"
                                  Opacity="0.42"
                                  ShadowDepth="{StaticResource Elevation.Medium.ShadowDepth}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeAccountHintTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeForegroundNameShadowStyle" TargetType="TextBlock">
        <Setter Property="Effect" Value="{DynamicResource Effect.Home.ForegroundTextShadow}" />
    </Style>

    <Style x:Key="HomeAccountNameTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource HomeForegroundNameShadowStyle}">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title2.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style x:Key="HomeVersionNameTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource HomeForegroundNameShadowStyle}">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title3.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeLaunchInstanceNameTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.BodyStrong.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="HomeLaunchInstanceSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Caption.Size}" />
        <Setter Property="LineHeight" Value="14" />
    </Style>

    <Style x:Key="HomeLaunchInstanceEmptyTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="24,0,24,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="-18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeChangeVersionButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Home.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Home.GameSettings.ForegroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Home.GameSettings.ForegroundPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeLaunchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="196" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,24,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
        <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Title3.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="RootGlow"
                                              BlurRadius="{StaticResource Elevation.Medium.BlurRadius}"
                                              Color="{DynamicResource Color.0891FE}"
                                              Direction="270"
                                              Opacity="0.3"
                                              ShadowDepth="{StaticResource Elevation.Medium.ShadowDepth}" />
                        </Border.Effect>
                        <Grid>
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="BackgroundScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="BaseBackground"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource Radius.Medium}" />
                                <Border x:Name="HoverBackground"
                                        Background="{DynamicResource Brush.047EDC}"
                                        CornerRadius="{StaticResource Radius.Medium}"
                                        Opacity="0" />
                                <Border x:Name="PressedBackground"
                                        Background="{DynamicResource Brush.036FC2}"
                                        CornerRadius="{StaticResource Radius.Medium}"
                                        Opacity="0" />
                            </Grid>
                            <Border x:Name="KeyboardFocusRing"
                                    Margin="2"
                                    BorderBrush="{DynamicResource Brush.FFFFFF}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter x:Name="ButtonContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Display"
                                              TextOptions.TextRenderingMode="Auto">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="ContentScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}"
                                                     EasingFunction="{StaticResource Motion.Easing.Enter}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}"
                                                     EasingFunction="{StaticResource Motion.Easing.Exit}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.BFFFFFFF}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="BaseBackground" Property="Background" Value="{DynamicResource Brush.5A5A5A}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionFieldSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Card.Surface}" />
        <Setter Property="behaviors:BackdropBlurHost.IsApplied" Value="True" />
        <Setter Property="behaviors:BackdropBlurHost.IsBlurEnabled" Value="{DynamicResource Is.Surface.BackdropBlur.Enabled}" />
        <Setter Property="behaviors:BackdropBlurHost.FallbackBrush" Value="{DynamicResource Brush.Card.Surface}" />
        <Setter Property="behaviors:SurfaceShadow.SuppressChildShadows" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=(behaviors:SurfaceShadow.SuppressChildShadows)}"
                         Value="True">
                <Setter Property="Effect" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyFieldSurfaceStyle"
           TargetType="Border"
           BasedOn="{StaticResource SectionFieldSurfaceStyle}">
        <Setter Property="MinHeight" Value="{StaticResource LauncherCompactControlHeight}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.TextBox.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ReadOnlyFieldTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.CFFFFFFF}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
