<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:Launcher.App.Controls"
                    xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
                    xmlns:converters="clr-namespace:Launcher.App.Converters"
                    xmlns:res="clr-namespace:Launcher.App.Resources">
    <Style x:Key="LauncherContentSectionStyle" TargetType="GroupBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Material.ContrastChip.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.BodyStrong.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <StackPanel>
                        <controls:BackdropBlurBorder HorizontalAlignment="Left"
                                                     Padding="12,6"
                                                     BaseBrush="Transparent"
                                                     TintBrush="{DynamicResource Brush.Material.ContrastChip.Fill}"
                                                     OverlayBrush="{DynamicResource Brush.Material.ContrastChip.Highlight}"
                                                     BorderBrush="{DynamicResource Brush.Material.ContrastChip.Border}"
                                                     BorderThickness="1"
                                                     BlurRadius="18"
                                                     BlurRenderingBias="Quality"
                                                     CornerRadius="10"
                                                     IsBlurEnabled="{DynamicResource Is.Material.ChromeBlur.Enabled}"
                                                     IsSourcePreblurred="False"
                                                     IsLiquidGlassEnabled="True"
                                                     LiquidGlassActivationDistance="28"
                                                     LiquidGlassHighlightLength="28"
                                                     LiquidGlassDistortion="6.6"
                                                     LiquidGlassHighlightGain="0.88"
                                                     LiquidGlassRestingRefraction="0.68"
                                                     RenderScale="1"
                                                     behaviors:LiquidGlassEdgeHighlight.IsEnabled="True"
                                                     behaviors:LiquidGlassEdgeHighlight.HighlightColor="{DynamicResource Color.Material.CompactGlassEdgeHighlight}"
                                                     behaviors:LiquidGlassEdgeHighlight.ActivationDistance="28"
                                                     behaviors:LiquidGlassEdgeHighlight.HighlightLength="28"
                                                     behaviors:LiquidGlassEdgeHighlight.HighlightThickness="0.9"
                                                     behaviors:RoundedClip.Radius="10"
                                                     Style="{DynamicResource BackdropBlurBorderStyle}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{StaticResource Typography.Title3.Size}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </controls:BackdropBlurBorder>
                        <ContentPresenter Margin="0,12,0,0"
                                          ContentSource="Content" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListPageItemButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Border x:Name="SelectedBackground"
                                    Background="{DynamicResource Brush.List.Item.Selected}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.List.Item.Hover}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.2EFFFFFF}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="TopSeparator"
                                    Height="1"
                                    Margin="48,0,16,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Control.Separator}" />
                            <Border x:Name="BottomSeparator"
                                    Height="1"
                                    Margin="48,0,16,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Control.Separator}"
                                    Opacity="0" />
                            <Border x:Name="KeyboardFocusRing"
                                    Margin="1"
                                    BorderBrush="{DynamicResource Brush.Accent.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="TopSeparator" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Exit}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="TopSeparator" Property="Opacity" Value="0" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}" Value="True">
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="TopSeparator" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFirstVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}" Value="True">
                            <Setter TargetName="TopSeparator" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLastVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}" Value="True">
                            <Setter TargetName="BottomSeparator" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPreviousItemHighlighted, RelativeSource={RelativeSource AncestorType={x:Type controls:ListPageItemButton}}}" Value="True">
                            <Setter TargetName="TopSeparator" Property="Opacity" Value="0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DownloadVersionListButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ListPageItemButtonStyle}" />

    <Style x:Key="ListPagePrimaryFloatingButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,28,28" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.FFFFFF}" />
        <Setter Property="Background" Value="{DynamicResource Brush.0891FE}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource Typography.BodyStrong.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Semibold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Panel.ZIndex" Value="4" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="{StaticResource Elevation.Medium.BlurRadius}"
                                              Color="{DynamicResource Color.0891FE}"
                                              Direction="270"
                                              Opacity="0.28"
                                              ShadowDepth="{StaticResource Elevation.Medium.ShadowDepth}" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="BaseBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.047EDC}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.036FC2}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="KeyboardFocusRing"
                                    Margin="2"
                                    BorderBrush="{DynamicResource Brush.FFFFFF}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.BFFFFFFF}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="BaseBackground" Property="Background" Value="{DynamicResource Brush.5A5A5A}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DownloadNextStepButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ListPagePrimaryFloatingButtonStyle}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ListPageSecondaryFloatingButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.F4FFFFFF}" />
        <Setter Property="Background" Value="{DynamicResource Brush.B03D3D3D}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.22FFFFFF}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Panel.ZIndex" Value="5" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Color="{DynamicResource Color.000000}"
                                              Opacity="0.28"
                                              ShadowDepth="0" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="BaseBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Pill}" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.D04A4A4A}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.E05A5A5A}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LauncherProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Brush.24FFFFFF}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="behaviors:ProgressBarAnimation.IsEnabled" Value="True" />
        <Setter Property="behaviors:ProgressBarAnimation.DurationMilliseconds" Value="{StaticResource Motion.Duration.DeliberateMilliseconds}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root"
                          Height="{TemplateBinding Height}"
                          UseLayoutRounding="True">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Pill}" />
                        <Grid ClipToBounds="True"
                              behaviors:RoundedClip.Radius="3">
                            <Border x:Name="Indicator"
                                    HorizontalAlignment="Stretch"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(behaviors:ProgressBarAnimation.AnimatedProgress)}" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      Color="{DynamicResource Color.0891FE}"
                                                      Opacity="0.26"
                                                      ShadowDepth="0" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryMenuButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:OptionHoverBehavior.IsEnabled" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="SelectedBackground"
                                    Background="{DynamicResource Brush.22FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.22FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.34FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Opacity="0" />
                            <Border x:Name="KeyboardFocusRing"
                                    Margin="1"
                                    BorderBrush="{DynamicResource Brush.Accent.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="behaviors:OptionHoverBehavior.IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Exit}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="behaviors:SecondaryMenuButtonBehavior.IsSelected" Value="True" />
                                <Condition Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                <Condition Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=(behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <Trigger Property="behaviors:SecondaryMenuButtonBehavior.SuppressSelectedBackground" Value="True">
                            <Setter TargetName="SelectedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.68" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryMenuDeleteButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Button.DangerIcon.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Small}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Small}" />
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.Button.DangerIcon.HoverBackground}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Button.DangerIcon.ForegroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Button.DangerIcon.ForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Muted}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DFFFFFFF}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Small}">
                        <Grid>
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.22FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.34FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Motion.Duration.Standard}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Motion.Duration.Exit}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Muted}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeLaunchMenuPinButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.B8FFFFFF}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            CornerRadius="{StaticResource Radius.Small}">
                        <Grid>
                            <Border x:Name="HoverBackground"
                                    Background="{DynamicResource Brush.22FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Opacity="0" />
                            <Border x:Name="PressedBackground"
                                    Background="{DynamicResource Brush.34FFFFFF}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.F4FFFFFF}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.F4FFFFFF}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.E8FFFFFF}" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Muted}" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0" />
                            <Setter TargetName="PressedBackground" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SvgIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Primary}" />
    </Style>

    <Style x:Key="DangerActionSvgIconStyle"
           TargetType="controls:SvgIcon"
           BasedOn="{StaticResource {x:Type controls:SvgIcon}}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Style>

    <Style x:Key="LauncherSwitchToggleButtonStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.SurfaceStrong}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="behaviors:SwitchThumbAnimation.IsEnabled" Value="True" />
        <Setter Property="behaviors:SwitchThumbAnimation.CheckedOffset" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          Background="Transparent">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Pill}" />
                        <Border x:Name="TrackOutline"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Control.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}" />
                        <Border x:Name="ActiveTrack"
                                Background="{DynamicResource Brush.Accent.Primary}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Opacity="0" />
                        <Border x:Name="Thumb"
                                Width="16"
                                Height="16"
                                Margin="3,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.FFFFFF}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslateTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource Elevation.Low.BlurRadius}"
                                                  Color="{DynamicResource Color.20000000}"
                                                  Opacity="0.2"
                                                  ShadowDepth="{StaticResource Elevation.Low.ShadowDepth}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="KeyboardFocusRing"
                                Margin="-2"
                                BorderBrush="{DynamicResource Brush.Accent.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActiveTrack" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveTrack"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource Motion.Duration.Fast}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveTrack"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Exit}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.98" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.98" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.92" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.434343}" />
                            <Setter TargetName="TrackOutline" Property="BorderBrush" Value="{DynamicResource Brush.18FFFFFF}" />
                            <Setter TargetName="ActiveTrack" Property="Background" Value="{DynamicResource Brush.434343}" />
                            <Setter TargetName="ActiveTrack" Property="Opacity" Value="0" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.C8D0D9}" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.62" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.434343}" />
                            <Setter TargetName="TrackOutline" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                            <Setter TargetName="ActiveTrack" Property="Background" Value="{DynamicResource Brush.Accent.Border}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.FFFFFF}" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.82" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LauncherSwitchToggleButtonDisabledStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource LauncherSwitchToggleButtonStyle}">
        <Setter Property="IsEnabled" Value="False" />
    </Style>

    <Style x:Key="InstallTaskCancelButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryMenuDeleteButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

</ResourceDictionary>
